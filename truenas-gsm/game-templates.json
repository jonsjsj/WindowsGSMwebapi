[
  {
    "id": "minecraft-java",
    "game": "Minecraft Java",
    "image": "itzg/minecraft-server:latest",
    "defaultPort": 25565,
    "defaultQueryPort": 25565,
    "defaultMaxPlayers": 20,
    "ports": [
      "__game__/tcp",
      "__game__/udp"
    ],
    "defaultEnv": {
      "EULA": "TRUE",
      "TYPE": "VANILLA",
      "VERSION": "LATEST",
      "MEMORY": "2G",
      "ENABLE_RCON": "true",
      "RCON_PASSWORD": "rconpass",
      "RCON_PORT": "25575"
    },
    "extraArgs": "-p 25575:25575",
    "consoleExec": "rcon-cli --password rconpass",
    "notes": "Supports VANILLA, FORGE, FABRIC, PAPER, PURPUR via TYPE env var.",
    "fileRoot": "/data"
  },
  {
    "id": "minecraft-bedrock",
